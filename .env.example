# Copy to .env and fill in real values before running docker-compose.prod.yml.
# Never commit .env to git.

# Database
DB_NAME=claims
DB_USERNAME=claims_prod
# Generate with: openssl rand -base64 24
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# JWT signing key (Base64, at least 32 bytes decoded).
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_TTL_MINUTES=60

# First admin account (created once on first boot if no ADMIN exists; remove afterwards).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_12_PLUS_CHAR_PASSWORD
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# Optional: comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Optional: brute-force protection for /api/v1/auth/login and /register (per IP).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Keep false in production unless Swagger is behind an internal VPN/proxy.
SWAGGER_ENABLED=false
APP_PORT=8080
